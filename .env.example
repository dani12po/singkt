APP_NAME=Singkt
APP_URL=https://www.singkt.my.id

DATABASE_URL="file:./dev.db"

# Rate limiting. Set TRUST_PROXY=true when running behind a reverse proxy
# (nginx/Caddy/Cloudflare) so per-IP buckets use the real client IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MEDIA_MAX=60
RATE_LIMIT_MEDIA_WINDOW_MS=600000
RATE_LIMIT_THUMB_MAX=240
TRUST_PROXY=false
# Entries dari kanan x-forwarded-for yang dianggap proxy tepercaya (default 1).
TRUSTED_PROXY_HOPS=1

# Belum diimplementasikan (placeholder, jangan diisi dulu):
# TURNSTILE_ENABLED, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY (captcha),
# SAFE_BROWSING_ENABLED, SAFE_BROWSING_API_KEY (reputasi URL).

# Admin auth: set a long random token. Login at /admin with this token.
ADMIN_TOKEN=change-me-to-a-long-random-token

# Downloader providers (official no-auth metadata endpoints; override if needed)
TIKTOK_OEMBED_ENDPOINT=https://www.tiktok.com/oembed
YOUTUBE_OEMBED_ENDPOINT=https://www.youtube.com/oembed
VIMEO_OEMBED_ENDPOINT=https://vimeo.com/api/oembed.json

# Media extractor (yt-dlp binary must be installed on the server, e.g. pip install yt-dlp)
# Leave empty to use "yt-dlp" from PATH.
YTDLP_PATH=
YTDLP_TIMEOUT_MS=45000

# Video+audio merger (ffmpeg binary must be installed on the server).
# Leave empty to use "ffmpeg" from PATH.
FFMPEG_PATH=
MUX_MAX_FILE_BYTES=1073741824
MUX_TIMEOUT_MS=300000
MAX_CONCURRENT_MUX=2

# Rewarded ads: HMAC secret for download tickets/tokens (set a long random value).
# Falls back to ADMIN_TOKEN when empty.
REWARD_SECRET=
REWARD_AD_SECONDS=30

# Media proxy guards (bytes / ms)
MEDIA_MAX_VIDEO_BYTES=314572800
MEDIA_MAX_IMAGE_BYTES=26214400
MEDIA_MAX_AUDIO_BYTES=104857600
MEDIA_MAX_THUMB_BYTES=10485760
MEDIA_FETCH_TIMEOUT_MS=15000
MEDIA_CHUNK_TIMEOUT_MS=30000

# Google AdSense publisher ID (ads load only after cookie consent).
# Kosongkan untuk menonaktifkan iklan sepenuhnya.
NEXT_PUBLIC_ADSENSE_ID=ca-pub-5613319962434210
# CSP_EXTRA_SCRIPT_SRC=https://pagead2.googlesyndication.com
# CSP_EXTRA_FRAME_SRC=https://googleads.g.doubleclick.net
# CSP_EXTRA_IMG_SRC=
# CSP_EXTRA_CONNECT_SRC=

# Security Shield (own-app WAF scoring; set false to disable).
SECURITY_SHIELD_ENABLED=true
SECURITY_BLOCK_MINUTES=10
# Extra explicitly-owned domains the internal security suite may target
# (localhost / 127.x / .local / .test / .example are always allowed).
OWNED_DOMAINS=

# Deployment notes: the downloader needs a persistent Node server with
# yt-dlp + ffmpeg installed, plus a writable SQLite file (or Postgres via
# DATABASE_URL with provider changed to postgresql). It is NOT compatible
# with serverless-only hosting (extraction binaries, temp files for mux,
# in-memory rate-limit/reward state).
